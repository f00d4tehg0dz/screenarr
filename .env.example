# Copy this to .env and fill it in. The .env file is gitignored. Keep it that way.

# LAN address of the box running this stack. Not 127.0.0.1.
HOST_IP=192.168.1.50

# Stream name. It shows up in every URL: /live, /live/whip, rtsp://.../live
STREAM_PATH=live

# Host ports. Change them if something else already owns the defaults.
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189
GATE_PORT=8080

# Login page. Comma separated name:password pairs. No commas in passwords.
GATE_USERS=me:change-this,guest:change-this-too
# Generate once with: openssl rand -hex 32
GATE_SESSION_SECRET=
SITE_NAME=Screenarr

# Discord. This is a user token for a throwaway account, not a bot token.
DISCORD_TOKEN=
GUILD_ID=
VOICE_CHANNEL_ID=

# Slash commands. Token for a real bot application that is invited to the server.
# Leave empty to skip slash commands.
BOT_TOKEN=
# 1 wipes the bot's old global commands on startup. Handy when reusing an old bot.
BOT_CLEAR_GLOBAL_COMMANDS=0

# Status. The bot shows "Watching <title>" on its own whenever BOT_TOKEN is set.
# This is what it calls the live feed.
LIVE_TITLE=Live stream
# 1 also puts a now playing card with a progress bar on the streaming account.
ACCOUNT_PRESENCE=0
# A Discord application id. The card needs one to show poster art. The bot's id works.
ACCOUNT_PRESENCE_APP_ID=
# Text channel where the bot keeps a now playing card with the poster. Leave empty to skip.
NOW_PLAYING_CHANNEL_ID=

# Text channel for ! commands typed in chat. Leave empty if you only want slash commands.
COMMAND_CHANNEL_ID=
COMMAND_PREFIX=!
# Optional. Leave both empty and anyone who can post in that channel can drive.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=

# Jellyfin. Leave JELLYFIN_URL empty to run live only.
JELLYFIN_URL=http://192.168.1.50:8096
JELLYFIN_API_KEY=
# A Jellyfin user id. Most versions need it, and playlists always do.
JELLYFIN_USER_ID=
# 1 plays random movies and episodes whenever the live feed is down.
IDLE_SHUFFLE=0
# Optional. Limit the shuffle and /random to one library or collection. The id is in its Jellyfin URL.
IDLE_LIBRARY_ID=
# Named lists for /shuffle. Each one is a name and the id of a Jellyfin playlist
# or collection, like christmas:abc123,horror:def456. The id is in its Jellyfin URL.
SHUFFLE_LISTS=
# Play one of those lists whenever the live feed is down. Use the name, not the id.
# This wins over IDLE_SHUFFLE. Clear it when the season is over.
IDLE_LIST=

# Seerr, for requesting things that are not in the library yet. Leave SEERR_URL
# empty to skip. Overseerr and Jellyseerr work too. The key is in Seerr's settings.
SEERR_URL=
SEERR_API_KEY=
# Text channel where the bot posts when a request has arrived. Needs BOT_TOKEN.
REQUESTS_CHANNEL_ID=

# Video. 720p30 is the ceiling for an account without Nitro.
HEIGHT=720
LIVE_FPS=30
BITRATE=4000
# 1 passes the OBS encode straight through. Needs B-frames 0 and 1s keyframes in OBS.
NO_TRANSCODE_LIVE=0
# 1 shaves about a second off the live feed. It can fail to start on long keyframe intervals.
MINIMIZE_LATENCY=0
